<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.CheckBox?>
<BorderPane fx:id="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.13" fx:controller="com.cps.vastuapp.VastuController">
    <center>
        <Pane fx:id="parentPane" style="-fx-background-color: #F0F8FF;">
            <Pane fx:id="imageContainer" prefHeight="600" prefWidth="800">
                <Canvas fx:id="imageCanvas" height="600.0" style="-fx-border-color: black; -fx-border-width: 2;" width="800.0" />
                <Circle fx:id="centerMarker" fill="blue" radius="5" visible="false" />
                <ImageView fx:id="overlayImageView1" fitHeight="600" fitWidth="800" visible="false" />
            </Pane>
        </Pane>
    </center>
    <top>
        <MenuBar prefHeight="0.0" prefWidth="899.0" style="-fx-background-color: #3E8EDE; -fx-text-fill: white;">
            <Menu style="-fx-text-fill: white;" text="File">
                <MenuItem onAction="#handleReset" text="New" />
                <SeparatorMenuItem />
                <MenuItem onAction="#handleExit" text="Exit" />
            </Menu>
            <Menu style="-fx-text-fill: white;" text="Edit">
                <MenuItem onAction="#promptCropImageFileMenu" text="Crop" />
            </Menu>
            <Menu style="-fx-text-fill: white;" text="Help">
                <MenuItem onAction="#showAbout" text="About" />
            </Menu>
        </MenuBar>
    </top>
    <left>
        <ToolBar orientation="vertical" prefHeight="785.0" prefWidth="210.0" style="-fx-background-color: #E6E6FA;">

            <HBox spacing="10">
                <Button fx:id="importButton" onAction="#handleImport" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Import" />
                <Button fx:id="resetButton" onAction="#handleReset" style="-fx-background-color: #FFC107; -fx-text-fill: black;" text="Reset" />
                <Button fx:id="exportButton" onAction="#handleExport" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Export" />
            </HBox>
            <Canvas fx:id="compassCanvas" height="200" width="200" />
            <ComboBox fx:id="primaryDropdown" prefHeight="27.0" prefWidth="197.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #4CAF50;" />
            <ComboBox fx:id="secondaryDropdown" prefHeight="27.0" prefWidth="197.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #FFC107;" />
            <ComboBox fx:id="tertiaryDropdown" prefHeight="27.0" prefWidth="198.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #F44336;" />
            <Label style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="Rotate Overlay: " />
            <TextField fx:id="angleInput" style="-fx-background-color: #FFFFFF;" />
            <Slider fx:id="angleSlider" blockIncrement="0.1" max="360.0" style="-fx-control-inner-background: #E6E6FA;" value="0.0" />
            <Label style="-fx-text-fill: #3E8EDE; -fx-font-weight: bold;" text="Opacity Canvas: " />
            <Slider fx:id="opacityCanvasSlider" max="1.0" min="0.0" style="-fx-control-inner-background: #E6E6FA;" value="1.0" />
            <Label style="-fx-text-fill: #3E8EDE; -fx-font-weight: bold;" text="Opacity Overlay: " />
            <Slider fx:id="opacitySlider" max="1.0" min="0.0" style="-fx-control-inner-background: #E6E6FA;" value="1.0" />
            <Button fx:id="pointSelectionButtton" onAction="#pointSelection" style="-fx-background-color: #3E8EDE; -fx-text-fill: white;" text="Select Points" />
            <Button fx:id="clearButton" onAction="#clearPoints" prefHeight="25.0" prefWidth="85.0" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Clear Points" />

            <Label style="-fx-text-fill: #3E8EDE; -fx-font-weight: bold;" text="Colour Selection Point Draw: " />
            <ComboBox fx:id="selectedPointColourDropdown" prefHeight="25.0" prefWidth="183.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #4CAF50;" />
            <CheckBox fx:id="colorCheckBox" onAction="#handleColorCheckBoxAction" selected="true" text="Enable" />

            <Label style="-fx-text-fill: #3E8EDE; -fx-font-weight: bold;" text="Colour Selection Box Draw: " />
            <ComboBox fx:id="selectedPointBoxColourDropdown" prefHeight="25.0" prefWidth="183.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #4CAF50;" />
            <CheckBox fx:id="pointBoxCheckBox" onAction="#handlePointBoxCheckBoxAction" selected="true" text="Enable" />

            <!--            <Button text="Undo" onAction="#handleImageOverLayUndo" />-->
<!--            <Button text="Redo" onAction="#handleImageOverLayRedo" />-->
        </ToolBar>

    </left>
    <right>


<!--            <Canvas fx:id="compassCanvas" width="200" height="200" />-->


    </right>
    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10; -fx-background-color: #E6E6FA;">
            <Label style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="Overlay Zoom: " />
            <Label fx:id="devtasZoomLabel" style="-fx-text-fill: black;" text="100%" />
            <Slider fx:id="devtasZoomSlider" max="300" min="10" style="-fx-control-inner-background: #E6E6FA;" value="100" />
            <Label style="-fx-text-fill: #FFC107; -fx-font-weight: bold;" text="Canvas Zoom: " />
            <Button fx:id="zoomOutButton" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="-" />
            <Slider fx:id="zoomSlider" blockIncrement="5" max="200" min="10" style="-fx-control-inner-background: #E6E6FA;" value="100" />
            <Button fx:id="zoomInButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="+" />
            <Label fx:id="zoomPercentageLabel" style="-fx-text-fill: black;" text="100%" />
        </HBox>
    </bottom>
</BorderPane>
