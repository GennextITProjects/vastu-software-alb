<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cps</groupId>
    <artifactId>VastuApplication</artifactId>
    <version>1.1-SNAPSHOT</version>
    <name>VastuApplication</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <javafx.version>17.0.13</javafx.version>
        <os.detected.classifier></os.detected.classifier>
    </properties>

    <!-- OS Detection -->
    <profiles>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <os.detected.classifier>windows</os.detected.classifier>
                <installer.type>exe</installer.type>
                <icon.path>src/main/resources/icons/app_icon.ico</icon.path>
                <javafx.dll.path>C:\Program Files\Java\javafx-sdk-17.0.13\bin</javafx.dll.path>
            </properties>
        </profile>
        <profile>
            <id>mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <os.detected.classifier>mac</os.detected.classifier>
                <installer.type>dmg</installer.type>
                <icon.path>src/main/resources/icons/app_icon.icns</icon.path>
                <javafx.dll.path>/usr/local/Cellar/openjfx/17.0.13/libexec/lib</javafx.dll.path>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.1.2</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.bootstrapfx</groupId>
            <artifactId>bootstrapfx-core</artifactId>
            <version>0.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- JavaFX Run Plugin -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>com.cps.vastuapp.VastuApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fat JAR Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.cps.vastuapp.VastuApplication</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy JAR for jpackage -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jar-for-jpackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/pkg-input"/>
                                <copy file="${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar"
                                      todir="${project.build.directory}/pkg-input"/>
                            </target>
                        </configuration>
                    </execution>
                    
                    <!-- OS-specific runtime file copying -->
                    <execution>
                        <id>copy-runtime-files</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Windows: Copy DLLs -->
                                <condition property="isWindows">
                                    <os family="windows"/>
                                </condition>
                                <antcall target="copy-windows-files" />
                                
                                <!-- macOS: Copy dylibs (if needed) -->
                                <condition property="isMac">
                                    <os family="mac"/>
                                </condition>
                                <antcall target="copy-mac-files" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- jpackage plugin -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.6.5</version>
                <executions>
                    <execution>
                        <id>default-jpackage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jpackage</goal>
                        </goals>
                        <configuration>
                            <name>MasterVastu</name>
                            <vendor>CPS Company</vendor>
                            <appVersion>1.0</appVersion>
                            <input>${project.build.directory}/pkg-input</input>
                            <mainJar>${project.build.finalName}-jar-with-dependencies.jar</mainJar>
                            <mainClass>com.cps.vastuapp.VastuApplication</mainClass>
                            <destination>${project.build.directory}/installer</destination>
                            <type>${installer.type}</type>
                            <icon>${icon.path}</icon>
                            
                            <!-- macOS specific options -->
                            <macPackageIdentifier>com.cps.mastervastu</macPackageIdentifier>
                            <macPackageName>MasterVastu</macPackageName>
                            <macSign>false</macSign>
                            
                            <!-- Windows specific options -->
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winDirChooser>true</winDirChooser>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Ant targets for OS-specific file copying -->
    <profiles>
        <profile>
            <id>windows-copy</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-antrun-plugin</artifactId>
                            <version>3.1.0</version>
                            <executions>
                                <execution>
                                    <id>copy-windows-files</id>
                                    <phase>none</phase>
                                    <configuration>
                                        <target name="copy-windows-files">
                                            <copy todir="${project.build.directory}/installer/MasterVastu/runtime/bin" overwrite="true">
                                                <fileset dir="${javafx.dll.path}" includes="*.dll"/>
                                            </copy>
                                        </target>
                                    </configuration>
                                    <goals>
                                        <goal>run</goal>
                                    </goals>
                                </execution>
                                <execution>
                                    <id>copy-mac-files</id>
                                    <phase>none</phase>
                                    <configuration>
                                        <target name="copy-mac-files">
                                            <copy todir="${project.build.directory}/installer/MasterVastu.app/Contents/runtime/lib" overwrite="true">
                                                <fileset dir="${javafx.dll.path}" includes="*.dylib"/>
                                            </copy>
                                        </target>
                                    </configuration>
                                    <goals>
                                        <goal>run</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

</project>